---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";

---

<BaseLayout title="About" sideBarActiveItemID="about">
  <div>
    <div class="text-3xl w-full font-bold mb-5">About</div>
  </div>

  <div class="mb-4">
    <p>
      I'm a software engineer and game developer focused on systems, tooling, and game systems.
      I build projects in Unity and Java, design backend services, and create data pipelines and local-first tools.
    </p>
  </div>

  <HorizontalCard
    title="Game Development"
    desc="Design and implement gameplay systems, rapid prototypes, and optimization using Unity and C#. Experience with DOTS, ECS, and networking."
    url="#"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Systems & DevOps"
    desc="Server configuration, containerization, and automation — Arch/Ubuntu server setup, Docker deployments, Tailscale, and security hardening."
    url="#"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Tooling & Data Pipelines"
    desc="Build local-first tooling and RAG pipelines using LangChain, ChromaDB, and Ollama for private document search and data workflows."
    url="#"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Backend & Desktop Apps"
    desc="Develop Java desktop applications and backend systems with MySQL, focusing on maintainability and clean architecture."
    url="#"
  />
</BaseLayout>
