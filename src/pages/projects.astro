---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Selected Projects</div>
  </div>

  <HorizontalCard
    title="DocPilot"
    desc="Local-first RAG CLI tool (Python, LangChain, Ollama, ChromaDB) — ingests PDFs/CSVs/websites and answers queries without cloud APIs."
    url="https://github.com/ASWIN-ASHOK-dev/docpilot"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="TinkerTiles — Memory Matrix"
    desc="48-hour Unity puzzle game demonstrating rapid prototyping, grid-based mechanics, and UI implementation in C#."
    url="https://tinkertiles.netlify.app"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Other Projects</div>
  </div>

  <HorizontalCard
    title="Hospital Management System"
    desc="Java desktop application with MySQL backend for patient records and appointment scheduling."
    url="https://github.com/ASWIN-ASHOK-dev/HospitalManagement"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Home Lab Server Setup"
    desc="Arch Linux home server with Docker, Tailscale, Pi-hole, SSH hardening, and automated container deployments."
    url="#"
  />
</BaseLayout>
